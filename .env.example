# NVIDIA NIM API Key (optional - enables AI succession guide generation)
NVIDIA_API_KEY=nvapi-your-key-here

# Twilio Email Configuration (Twilio SendGrid Web API v3)
# Sign up and create an API key at https://app.sendgrid.com/settings/api_keys
TWILIO_SENDGRID_API_KEY=SG.your-sendgrid-api-key-here
TWILIO_FROM_EMAIL=claims@assetbridge.in
TWILIO_FROM_NAME=Asset Bridge Succession Engine

# Twilio Communications (Optional: SMS delivery tracking for claiming dossiers)
# Find your Account SID & Auth Token at https://console.twilio.com
TWILIO_ACCOUNT_SID=ACyour-twilio-account-sid
TWILIO_AUTH_TOKEN=your-twilio-auth-token
TWILIO_PHONE_NUMBER=+1234567890

# Fallback SMTP Configuration (Twilio SendGrid SMTP Relay)
SMTP_HOST=smtp.sendgrid.net
SMTP_PORT=587
SMTP_USER=apikey
SMTP_PASSWORD=SG.your-sendgrid-api-key-here
SMTP_FROM_EMAIL=claims@assetbridge.in
SMTP_FROM_NAME=Asset Bridge Succession Engine
SMTP_USE_TLS=true
SMTP_ENABLED=false
