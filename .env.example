# NVIDIA NIM API Key (optional - enables AI succession guide generation)
NVIDIA_API_KEY=nvapi-your-key-here

# Primary Email SMTP Configuration (Google Workspace / Gmail with App Password or custom SMTP)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=claims@assetbridge.in
SMTP_PASSWORD=your-google-app-password
SMTP_FROM_EMAIL=claims@assetbridge.in
SMTP_FROM_NAME=Asset Bridge Succession Engine
SMTP_USE_TLS=true
SMTP_ENABLED=true

# Twilio Communications & Comms Email (https://comms.twilio.com/v1/Emails and SMS)
TWILIO_ACCOUNT_SID=ACyour-twilio-account-sid
TWILIO_AUTH_TOKEN=your-twilio-auth-token
TWILIO_PHONE_NUMBER=+1234567890
TWILIO_COMMS_FROM_EMAIL=ACyour-twilio-account-sid@twilio.email
TWILIO_COMMS_FROM_NAME=Trial with Twilio

# Twilio SendGrid Web API v3 (Optional if using SendGrid API key instead of SMTP)
TWILIO_SENDGRID_API_KEY=

# Redis Storage Configuration for Scrapy (Optional: defaults to SQLite Document Vault if offline)
REDIS_URL=redis://localhost:6379/0
REDIS_ENABLED=false
