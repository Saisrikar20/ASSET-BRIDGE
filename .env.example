# NVIDIA NIM API Key (optional - enables AI succession guide generation)
NVIDIA_API_KEY=nvapi-your-key-here

# Email & SMTP Configuration (Mailshield AI / Standard SMTP)
SMTP_HOST=smtp.mailshield.ai
SMTP_PORT=587
SMTP_USER=claims@assetbridge.in
SMTP_PASSWORD=your-mailshield-or-app-password
SMTP_FROM_EMAIL=claims@assetbridge.in
SMTP_FROM_NAME=Asset Bridge Succession Engine
SMTP_USE_TLS=true
SMTP_ENABLED=false
