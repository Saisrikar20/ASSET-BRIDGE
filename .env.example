# fastapi-backend/
PORT=4000
AUTH_SECRET=asset-bridge-dev-secret

# NVIDIA NIM (NVIDIA Inference Microservices) API Key
# Get your key at: https://build.nvidia.com/
NVIDIA_API_KEY=nvapi-your-key-here
# Optional model override (defaults to meta/llama-3.1-70b-instruct)
# Popular choices: meta/llama-3.1-70b-instruct, meta/llama-3.3-70b-instruct, mistralai/mixtral-8x22b-instruct-v0.1
NVIDIA_MODEL=meta/llama-3.1-70b-instruct
NVIDIA_BASE_URL=https://integrate.api.nvidia.com/v1

# Alternative LLM keys (optional fallbacks)
GEMINI_API_KEY=
OPENAI_API_KEY=
